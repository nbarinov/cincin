{
  "name": "cincin-skin",
  "version": "0.0.0",
  "private": true,
  "description": "The framework-free part of the bundled skin, inlined into every adapter at build time",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "cincin": "workspace:^"
  },
  "devDependencies": {
    "cincin": "workspace:*",
    "vitest": "^4.1.10",
    "tsdown": "0.22.14"
  }
}
