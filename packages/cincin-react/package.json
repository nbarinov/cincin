{
  "name": "cincin-react",
  "version": "0.1.0-beta.5",
  "description": "🥂 React bindings for cincin: headless hook, primitives, ready-to-use skin",
  "license": "MIT",
  "author": "Nikita Barinov",
  "homepage": "https://cincin.nbarinov.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbarinov/cincin.git",
    "directory": "packages/cincin-react"
  },
  "keywords": [
    "toast",
    "notifications",
    "react",
    "headless"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "source": "./src/core/index.ts",
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "cincin": "workspace:^"
  },
  "peerDependencies": {
    "cincin": "workspace:^",
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.8",
    "vitest": "^4.1.10"
  }
}
