{
  "name": "cincin-vue",
  "version": "0.1.0-beta.3",
  "description": "🥂 Vue bindings for cincin: headless composables, primitives, ready-to-use skin",
  "license": "MIT",
  "author": "Nikita Barinov",
  "homepage": "https://cincin.nbarinov.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbarinov/cincin.git",
    "directory": "packages/cincin-vue"
  },
  "keywords": [
    "toast",
    "notifications",
    "vue",
    "headless"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "source": "./src/core/index.ts",
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "vue-tsc -p tsconfig.json"
  },
  "dependencies": {
    "cincin": "workspace:^"
  },
  "peerDependencies": {
    "cincin": "workspace:^",
    "vue": ">=3.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/vue": "^8.1.0",
    "@tsdown/css": "0.22.14",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "unplugin-vue": "^7.2.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  }
}
