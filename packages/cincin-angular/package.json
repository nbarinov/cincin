{
  "name": "cincin-angular",
  "version": "0.2.0",
  "description": "\ud83e\udd42 Angular bindings for cincin: headless directives, primitives, ready-to-use skin",
  "license": "MIT",
  "author": "Nikita Barinov",
  "homepage": "https://cincin.nbarinov.io",
  "bugs": "https://github.com/nbarinov/cincin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbarinov/cincin.git",
    "directory": "packages/cincin-angular"
  },
  "keywords": [
    "toast",
    "snackbar",
    "toaster",
    "notifications",
    "angular",
    "headless"
  ],
  "type": "module",
  "files": [
    "dist",
    "!dist/package.json",
    "!dist/README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/types/cincin-angular.d.ts",
        "default": "./dist/fesm2022/cincin-angular.mjs"
      }
    },
    "./core": {
      "source": "./src/core/index.ts",
      "import": {
        "types": "./dist/types/cincin-angular-core.d.ts",
        "default": "./dist/fesm2022/cincin-angular-core.mjs"
      }
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/types/cincin-angular.d.ts",
        "default": "./dist/fesm2022/cincin-angular.mjs"
      },
      "./core": {
        "types": "./dist/types/cincin-angular-core.d.ts",
        "default": "./dist/fesm2022/cincin-angular-core.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "ngc -p tsconfig.json"
  },
  "peerDependencies": {
    "@angular/common": ">=19",
    "@angular/core": ">=19",
    "cincin": "workspace:^"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.2",
    "@analogjs/vitest-angular": "^2.7.2",
    "@angular/build": "^22.1.8",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/compiler-cli": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.1",
    "cincin": "workspace:*",
    "cincin-skin": "workspace:*",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.1.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
